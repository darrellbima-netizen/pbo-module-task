//kelas: RumahSakit
class RumahSakit
{
    private List<Orang> daftarOrang = new List<Orang>();

    public void TambahOrang(Orang orang)
    {
        daftarOrang.Add(orang);
        Console.WriteLine($"  >> {orang.Nama} berhasil ditambahkan ke rumah sakit.");
    }

    public void DaftarOrang()
    {
        Console.WriteLine($"\n  Total orang yang terdaftar: {daftarOrang.Count}");
        Console.WriteLine("  " + new string('-', 40));
        foreach (var o in daftarOrang)
        {
            Console.WriteLine($"\n  [{o.GetType().Name}]");
            o.InfoOrang();
        }
    }

    public List<Orang> GetDaftarOrang() => daftarOrang;
}

//PROGRAM UTAMAAA------------------------------------------------------------------------------------------------------
class Program
{
    static void Separator(string judul)
    {
        Console.WriteLine("\n" + new string('=', 55));
        Console.WriteLine($"  {judul}");
        Console.WriteLine(new string('=', 55));
    }

    static void Main(string[] args)
    {
        //Buat objek rumah sakit
        Separator("membuat objek rumah sakit");
        RumahSakit rs = new RumahSakit();
        Console.WriteLine("Rumah Sakit Super Sehat siap membantu");

        //Buat beberapa objek orang
        Separator("membuat objek orang");

        Dokter dokter1 = new Dokter("Sugeng Riyadi", 45, "Kardiologi");
        Dokter dokter2 = new Dokter("Bahlil Raharjodinata", 38, "Jantung");
        Perawat perawat1 = new Perawat("Budi Mbud", 30, "Keperawatan Umum");
        Pasien pasien1 = new Pasien("Parmun", 50, "Nyeri dada");
        PasienAnak pasienAnak1 = new PasienAnak("Ahlul Mini", 8, "Demam tinggi");
        PasienDewasa pasienDewasa1 = new PasienDewasa("Pardi Gwakomala", 35, "Sakit punggung");

        Console.WriteLine("semua orang baik petugas bahkan pasien berhasil ditambahkan.");

        //Tambahkan ke rumah sakit
        Separator("menambahkan orang ke rumah sakit");
        rs.TambahOrang(dokter1);
        rs.TambahOrang(dokter2);
        rs.TambahOrang(perawat1);
        rs.TambahOrang(pasien1);
        rs.TambahOrang(pasienAnak1);
        rs.TambahOrang(pasienDewasa1);

        //Tampilkan semua data yang sudah ada
        Separator("daftar semua orang di rumah sakit");
        rs.DaftarOrang();

        //Demonstrasi dari polymorphism
        Separator("contoh penerapan polymorphism");
        Console.WriteLine("\n  command bagian ini akan memanggil aktivitas dari setiap objek melalui referensi Orang:\n");
        foreach (Orang o in rs.GetDaftarOrang())
        {
            o.Aktivitas();
        }

        //Panggil method khusus/spesifik dari setiap class
        Separator("buat memanggil hal khusus");

        Console.WriteLine("\n  ---- CekKeluhan ----");
        pasien1.CekKeluhan();
        pasienAnak1.CekKeluhan();
        pasienDewasa1.CekKeluhan();

        Console.WriteLine("\n  ---- CekSpesialis ----");
        dokter1.CekSpesialis();
        perawat1.CekSpesialis();
        dokter2.CekSpesialis();

        Console.WriteLine("\n  ---- Diagnosa (Dokter) ----");
        dokter1.Diagnosa();
        dokter2.Aktivitas();

        Console.WriteLine("\n  ---- CekPasien (Perawat) ----");
        perawat1.CekPasien();

        Console.WriteLine("\n  ---- Menangis (PasienAnak) ----");
        pasienAnak1.Menangis();

        Console.WriteLine("\n  ---- Konsultasi (PasienDewasa) ----");
        pasienDewasa1.Konsultasi();
    }
}
